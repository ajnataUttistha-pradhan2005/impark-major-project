# ==============================================================================
# IMPARK Evaluator Configuration (.env)
# Arize Phoenix + Gemma 4 (e4b) Local LLM-as-a-Judge Observability Stack
# ==============================================================================

# Local LLM Server (Ollama / vLLM)
OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=ollama
AGENT_MODEL=gemma4:e4b
EVAL_MODEL=gemma4:e4b
EVAL_LLM_TIMEOUT=15.0

# Redis Streams Configuration (Non-blocking queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=phoenix-agent-traces

# PostgreSQL Unified Storage Configuration (Port 5433 isolates from host Postgres)
EVAL_POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=phoenix

# Arize Phoenix Tracing Backend (UI: http://localhost:6006)
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=impark-deepagents
