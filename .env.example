# Copy to .env for local development. Never commit credentials.
# Keep Compose volume/container names consistent across teammate checkouts.
COMPOSE_PROJECT_NAME=impark-major-project
APPLICATION_ENV=development
ENABLE_DEVELOPMENT_API=true
CORS_ORIGINS=["http://localhost:3000"]
MAX_ITERATIONS=8
MAX_AGENT_RETRIES=2
REPEATED_ACTION_THRESHOLD=2
MAX_CLARIFICATIONS=2
MAX_ACTION_CALLS=6
ENTITY_AUTO_RESOLVE_THRESHOLD=0.95
TRACE_BUFFER_SIZE=1024
TRACE_SHUTDOWN_SECONDS=1
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
LLM_PROVIDER=grounded
# To use local generation: set provider=ollama and fill the two values below.
# Current demo model: gemma4:e4b. On a 4 GB GPU it can also use system RAM.
# Local Ollama usually listens on port 11434.
LLM_MODEL=
OLLAMA_BASE_URL=
LLM_CONTEXT_TOKENS=4096
LLM_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=35
LLM_KEEP_ALIVE=30m
TEXT_INTENT_MODEL_ENABLED=true
TEXT_INTENT_TIMEOUT_SECONDS=12
# Optional shared workspace token. Required outside explicit local development bypass.
API_KEY=
MAX_ACTIVE_RUNS=4
MAX_SESSION_IMAGES=10
# DATABASE_URL=
# REDIS_URL=
# Shared Neo4j connection. Fill all four fields locally before enabling.
NEO4J_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_ALLOW_WRITES=false
NEO4J_TRANSACTION_TIMEOUT_SECONDS=10
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_ACQUISITION_TIMEOUT_SECONDS=10
NEO4J_MAX_POOL_SIZE=20
NEO4J_MAX_RESULT_RECORDS=1000
# QDRANT_URL=
# LLM_MODEL=
# OLLAMA_BASE_URL=
# VLLM_BASE_URL=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# NEO4J_AUTH=

# PostgreSQL/Qdrant search. Set connection values before enabling.
TEXT_SEARCH_ENABLED=false
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=15432
POSTGRES_POOL_SIZE=5
STORE_TIMEOUT_SECONDS=10
STORE_MAX_RECORDS=10000
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=plant_names_v1
TEXT_SEMANTIC_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=data/model-cache
ACTION_TIMEOUT_SECONDS=45

# Optional supplied 40-class leaf Image Agent. Index explicitly before enabling.
IMAGE_ENABLED=false
IMAGE_MODEL_PATH=data/image/xception_model.keras
IMAGE_CLASSES_PATH=data/image/class_indices.json
IMAGE_MANIFEST_PATH=data/image/index_manifest.json
IMAGE_COLLECTION=plant_images_v1
IMAGE_STRATEGY=fusion
IMAGE_THREADS=4
IMAGE_MIN_SIMILARITY=0.6
